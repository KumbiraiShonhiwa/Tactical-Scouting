# Shared local env for all Edge Functions, auto-loaded by `supabase start` / `supabase
# functions serve`. Copy to `supabase/functions/.env` for local development (already covered
# by the repo's blanket `.env` gitignore pattern — never commit real values).
#
# SUPABASE_URL / SUPABASE_ANON_KEY are injected automatically by the local stack (SUPABASE_URL
# resolves to the *internal* Docker-network address, e.g. http://kong:8000 — correct for
# server-to-server Storage/PostgREST calls, but not reachable from a browser). The rest must
# be set explicitly.

API_BASE_URL=http://host.docker.internal:8000
# generate-export's signed URL must use a browser-reachable base, not the internal
# SUPABASE_URL above — locally this is the host-exposed API port from `supabase start`'s
# output (API_URL); in production it's the same as SUPABASE_URL.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
INTERNAL_FUNCTION_SECRET=replace-with-a-random-shared-secret
PIPELINE_WEBHOOK_SECRET=replace-with-a-different-random-shared-secret
