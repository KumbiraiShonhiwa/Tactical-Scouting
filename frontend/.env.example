# See docs/environment-and-secrets.md for full descriptions.
# Copy to .env.local for local development. Never commit .env.local with real values.
# Only VITE_-prefixed vars are bundled into the client build — keep it that way.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
VITE_API_BASE_URL=http://localhost:8000
